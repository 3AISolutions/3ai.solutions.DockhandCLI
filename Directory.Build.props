<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <Version>1.2.0</Version>
    <Authors>3AI Solutions</Authors>
    <Company>3AI Solutions</Company>
    <Product>DockhandCLI</Product>
    <Copyright>Copyright (c) 2026 3AI Solutions</Copyright>
    <RepositoryUrl>https://github.com/3AISolutions/3ai.solutions.DockhandCLI</RepositoryUrl>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
